---
const menuitems = [
  { href: "/about", label: "About us" },
  { href: "/services", label: "Services" },
  { href: "/#cases", label: "Use Cases" },
  { href: "/pricing", label: "Pricing" },
  { href: "/articles", label: "Blog" },
];

const navButton = {
  href: "https://github.com/manulthanura/nineteentwentys",
  label: "Request a quote",
};
---

<div class="fixed top-4 left-0 right-0 z-50 px-6 md:px-32">
  <nav class="w-full bg-white/50 backdrop-blur-xl border border-black/5 rounded-[32px] transition-all duration-300 shadow-sm hover:shadow-md hover:bg-white/80">

    <header class="flex justify-between items-center py-4 px-8">

      <!-- Logo -->
      <a href="/" class="flex items-center">
        <div class="bg-black p-2 rounded-xl shrink-0">
          <img src="/icons/LogoInstaWhite.png" class="h-8 w-auto" alt="Logo" />
        </div>
        <img src="/icons/nineteentwentys_logo_black.png" class="h-6 w-auto ml-4 opacity-90" alt="nineteentwentys" />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex items-center gap-8">

        {menuitems.map((item) => (
          <a
            href={item.href}
            class="text-black font-boska text-xl font-medium decoration-black/10 underline-offset-8 transition-all hover:underline"
          >
            {item.label}
          </a>
        ))}

        <a class="btn-primary py-3 px-6 text-base" href={navButton.href}>
          {navButton.label}
        </a>

      </div>

      <!-- Mobile Toggle -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded-xl hover:bg-black/5"
        aria-label="Toggle Menu"
        aria-expanded="false"
      >

        <svg id="menu-open" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16"/>
        </svg>

        <svg id="menu-close" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 hidden" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>

      </button>

    </header>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden px-8 pb-6">

      <ul class="flex flex-col gap-4">

        {menuitems.map((item) => (
          <li>
            <a
              href={item.href}
              class="block text-black font-boska text-xl font-medium"
              data-close-menu
            >
              {item.label}
            </a>
          </li>
        ))}

      </ul>

      <a
        class="btn-primary py-3 px-6 text-base mt-4 inline-block"
        href={navButton.href}
      >
        {navButton.label}
      </a>

    </div>

  </nav>
</div>

<script is:inline>

document.addEventListener("DOMContentLoaded", () => {

  const toggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open");
  const closeIcon = document.getElementById("menu-close");

  if (!toggle || !mobileMenu) return;

  toggle.addEventListener("click", () => {

    const isOpen = mobileMenu.classList.toggle("hidden");

    toggle.setAttribute("aria-expanded", !isOpen);

    openIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");

  });

  const closeLinks = document.querySelectorAll("[data-close-menu]");

  closeLinks.forEach(link => {

    link.addEventListener("click", () => {

      mobileMenu.classList.add("hidden");

      toggle.setAttribute("aria-expanded", "false");

      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");

    });

  });

});

</script>