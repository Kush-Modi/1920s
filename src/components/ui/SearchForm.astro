<form id="search-form" class="flex items-center" action="/articles/search">
  <label for="search-input" class="sr-only">Search</label>
  <div class="relative w-full">            
    <input
      type="text"
      id="query"
      name="query"
      class="bg-gray-50 border border-black/10 text-black text-sm rounded-xl focus:ring-black focus:border-black block w-full p-3 outline-none transition-all"
      placeholder="Search articles..."
      required
    />
  </div>
  <button
    type="submit"
    class="p-3 ms-2 text-sm font-medium text-white bg-black rounded-xl border border-black hover:bg-zinc-800 transition-all focus:ring-4 focus:outline-none focus:ring-black/10"
  >
    <svg
      class="w-4 h-4"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 20 20"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"
      />
    </svg>
    <span class="sr-only">Search</span>
  </button>
</form>
