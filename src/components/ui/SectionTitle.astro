---
const { sectionTitle, description } = Astro.props;
---

<div class="flex flex-col items-start gap-4 mb-16">
  <span class="section-tag">{sectionTitle}</span>
  <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-16">
    <h2 class="text-5xl md:text-7xl leading-tight max-w-2xl">{sectionTitle}</h2>
    <p class="text-xl text-gray-dark max-w-xl font-general-sans leading-relaxed">
        {description}
    </p>
  </div>
</div>
