<div id="intro-container" class="relative w-full h-[450vh] z-[60]">
  <div id="intro-sticky" class="sticky top-0 h-screen w-full overflow-hidden">
    <video
      id="scroll-video"
      src="/videos/1920sMotionGraphics_1.mp4"
      class="w-full h-full object-cover"
      muted
      playsinline
      preload="auto"
    ></video>
    <div
      id="intro-overlay"
      class="absolute inset-0 bg-black opacity-0 pointer-events-none"
    ></div>
  </div>
</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const container = document.getElementById("intro-container");
  const sticky    = document.getElementById("intro-sticky");
  const video     = document.getElementById("scroll-video");
  const overlay   = document.getElementById("intro-overlay");
  const hero      = document.getElementById("hero-section");
  const navbar    = document.querySelector("nav");

  if (!container || !sticky || !(video instanceof HTMLVideoElement)) return;

  /* ── duration ── */
  let duration = 12;
  video.addEventListener("loadedmetadata", () => {
    duration = video.duration || 12;
  });

  /* ── initial UI state ── */
  if (hero)   hero.style.opacity   = "0";
  if (navbar) navbar.style.opacity = "0";

  /* ── recalculate scroll range on resize ── */
  let start = 0, end = 1;
  function recalc() {
    start = container.offsetTop;
    end   = start + container.offsetHeight - window.innerHeight;
  }
  recalc();
  window.addEventListener("resize", recalc);

  /* ── scroll handler ── */
  let rafId = null;

  function update() {
    rafId = null;

    const scroll   = window.scrollY;
    const progress = Math.min(Math.max((scroll - start) / (end - start), 0), 1);

    /* direct scrub — no lag, guaranteed to finish */
    const targetTime = progress * duration;
    if (Math.abs(video.currentTime - targetTime) > 0.01) {
      video.currentTime = targetTime;
    }

    /* fade zone: last 8% of scroll */
    const fadeStart = 0.92;
    if (progress >= fadeStart) {
      const t      = (progress - fadeStart) / (1 - fadeStart); // 0 → 1
      const eased  = t * t;

      if (overlay) overlay.style.opacity = String(eased);
      if (hero)    hero.style.opacity    = String(eased);
      if (navbar)  navbar.style.opacity  = String(eased);
      sticky.style.opacity               = String(1 - eased);
    } else {
      sticky.style.opacity               = "1";
      if (overlay) overlay.style.opacity = "0";
      if (hero)    hero.style.opacity    = "0";
      if (navbar)  navbar.style.opacity  = "0";
    }
  }

  /* throttle to one rAF per scroll event */
  window.addEventListener("scroll", () => {
    if (!rafId) rafId = requestAnimationFrame(update);
  }, { passive: true });

  /* run once on load so first paint is correct */
  update();
});
</script>

<style is:global>
body { overflow-x: hidden; }

#scroll-video {
  transform: translateZ(0);
  backface-visibility: hidden;
  will-change: transform;
}
</style>