---
import Section from "./Section.astro";

const sponsors = [
  { logo: "/icons/company-logo1.svg", alt: "Zoom" },
  { logo: "/icons/company-logo2.svg", alt: "Netflix" },
  { logo: "/icons/company-logo3.svg", alt: "Notion" },
  { logo: "/icons/company-logo4.svg", alt: "HubSpot" },
  { logo: "/icons/company-logo5.svg", alt: "Dribbble" },
  { logo: "/icons/company-logo6.svg", alt: "Amazon" },
];
---

<Section id="sponsors">

  <div class="py-12 border-y border-black/5">

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-12 items-center opacity-50 hover:opacity-100 transition-opacity duration-500">

      {sponsors.map((sponsor) => (

        <div class="flex justify-center transition-transform duration-300 hover:scale-110">

          <img
            src={sponsor.logo}
            alt={`${sponsor.alt} logo`}
            loading="lazy"
            class="h-8 w-auto grayscale hover:grayscale-0 transition-all duration-300"
          />

        </div>

      ))}

    </div>

  </div>

</Section>