---
import siteData from "../../data/siteData.json";
import jsonLDGenerator from "../../utils/jsonLD";

const {
  title,
  description,
  image,
  robots = false,
  frontmatter
} = Astro.props;

const url = Astro.url.href;

const jsonLD = jsonLDGenerator({
  type: frontmatter ? "post" : "website",
  post: frontmatter,
  url
});

const imageSrc = image?.src || siteData.image.src;
const imageAlt = image?.alt || siteData.image.alt;
---

<!-- Basic SEO -->
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:site_name" content={siteData.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageSrc} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageSrc} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:domain" content={import.meta.env.SITE} />

<!-- Robots -->
{robots && <meta name="robots" content="noindex,nofollow" />}

<!-- Structured Data -->
<Fragment set:html={jsonLD} />