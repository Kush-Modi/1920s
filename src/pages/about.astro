---
import MainLayout from "../layouts/MainLayout.astro";
import Sponsors from "../components/sections/Sponsors.astro";
import Services from "../components/sections/Services.astro";
---

<MainLayout title="About us">
	<main class="space-y-32 mb-32">
        <div class="px-6 md:px-32">
            <div class="relative flex flex-col items-center text-center space-y-12" id="hero">
                <span class="btn-pill">Our Mission</span>
                <h1 class="text-6xl md:text-8xl lg:text-[100px] leading-[0.9] tracking-tighter max-w-4xl mx-auto">
                    We Navigate the <br/>
                    <span class="font-light italic">Digital</span> landscape <br/>
                    for <span class="font-outline">Success</span>
                </h1>
                <p class="text-xl md:text-2xl text-gray-dark max-w-3xl leading-relaxed font-general-sans">
                    Our digital marketing agency helps businesses grow and succeed online through strategic SEO, social media, and content creation.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#contact" class="btn-primary py-5 px-10 text-xl">
                        Book a Consultation
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        <Sponsors />
        <Services />
	</main>
</MainLayout>
